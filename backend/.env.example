# Copy to .env — never commit real secrets.
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Neon connection string (Neon dashboard → Connect → copy the pooled URI).
# Looks like: postgres://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/securemarket?sslmode=require
DATABASE_SSL=true
TYPEORM_SYNC=true
# Live card/bank funding via Paystack. Leave unset for dev test-mode funding.
# Get keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
# Where Paystack returns buyers after payment (defaults to FRONTEND_URL).
PAYSTACK_CALLBACK_URL=
